{
  "name": "absam-ai-video-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first, open-source cloud AI video editor with Arabic RTL subtitles and FFmpeg rendering",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:ui": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "check": "bash scripts/check.sh",
    "fonts": "bash scripts/install-fonts.sh",
    "token:hf": "bash scripts/set-hf-token.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
