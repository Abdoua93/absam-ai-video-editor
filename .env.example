# Server
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
# Set this before exposing the app publicly. Leave empty for local Termux use.
APP_PASSWORD=

# Uploads / queue
MAX_UPLOAD_MB=800
MAX_CLIPS=20
JOB_CONCURRENCY=1

# FFmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_PRESET=veryfast
FFMPEG_CRF=21
OUTPUT_FPS=30
# Folder containing Noto Naskh Arabic / Noto Sans Arabic (.ttf). Optional.
FONTS_DIR=./assets/fonts
SUBTITLE_FONT=Noto Naskh Arabic

# Optional local Whisper.cpp — free, offline, no paid API.
# Example: WHISPER_BIN=/absam/models/whisper-cli
#          WHISPER_MODEL=/absam/models/ggml-base.ar.bin
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_LANG=ar

# ---------------------------------------------------------------------------
# AI generation (/api/video/generate). Free engines only.
# No API key or token is ever read by or sent to the browser.
# ---------------------------------------------------------------------------
# huggingface-ltx = free Upsampler LTX 2.3 Space (default; text + image).
# huggingface-wan22 = previous free Gradio Space (rollback option).
# wan22-local = legacy local adapter. none = intentionally disabled.
VIDEO_PROVIDER=huggingface-ltx
VIDEO_JOB_CONCURRENCY=1
MAX_GENERATION_IMAGE_MB=10
VIDEO_GENERATION_TIMEOUT_MS=1800000

# Free Hugging Face Gradio Space: Upsampler/ltx-video (LTX 2.3, text + image).
# Browser-compatible API: /gradio_api/queue/join + /gradio_api/queue/data.
# Input order is read from /gradio_api/info (parameter_name) at runtime.
HF_LTX_SPACE_ID=Upsampler/ltx-video
HF_LTX_SPACE_URL=https://upsampler-ltx-video.hf.space
HF_LTX_GRADIO_API_NAME=generate_video
HF_LTX_GENERATION_TIMEOUT_MS=600000
# Low presets fit the anonymous ZeroGPU quota; high presets consume far more.
HF_LTX_HIGH_RES=0
HF_LTX_ENHANCE_PROMPT=0
HF_LTX_RANDOMIZE_SEED=1
HF_LTX_SEED=10
# Optional backend-only token from a FREE Hugging Face account.
# It raises the daily ZeroGPU quota and is verified via /api/whoami-v2.
# Never put it in React/public files or commit it (.env is gitignored).
# Create a Read-only token at https://huggingface.co/settings/tokens
# HF_LTX_TOKEN=
# Optional override of the identity endpoint used for the auth check.
# HF_WHOAMI_URL=https://huggingface.co/api/whoami-v2
# HF_TOKEN is a fallback shared with the legacy Wan provider.
# HF_TOKEN=

# Free Hugging Face Gradio Space: Wan 2.2 TI2V-5B (text + image to video).
# Verified API: POST /gradio_api/call/generate_video with 12 inputs.
HF_SPACE_ID=Hamzakhan1/wan2.2-text-image-to-video
HF_SPACE_URL=https://hamzakhan1-wan2-2-text-image-to-video.hf.space
# Optional override for tests/self-hosted metadata endpoint.
# HF_SPACE_API_URL=https://huggingface.co/api/spaces/Hamzakhan1/wan2.2-text-image-to-video
HF_GRADIO_API_NAME=generate_video
HF_GENERATION_TIMEOUT_MS=900000
HF_STATUS_TIMEOUT_MS=10000
HF_SAMPLING_STEPS=20
# Leave empty to use the Space defaults.
HF_GUIDE_SCALE=
HF_SHIFT=
HF_SOLVER=unipc
HF_OFFLOAD_MODEL=1
# Optional, backend-only. The Space is public, so this is normally unnecessary.
# HF_TOKEN=

# Legacy local Wan 2.2 adapter (not used by the default provider).
# WAN22_MODEL_DIR is NOT required for huggingface-wan22.
# WAN22_ENABLED=0

# Optional S3-compatible object storage (MinIO, Cloudflare R2, etc.).
# Leave S3_ENDPOINT empty to use the local DATA_DIR volume.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=absam-video
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false
